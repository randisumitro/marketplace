# Salin jadi .env.local untuk development. Di Vercel, isi ini lewat Project Settings > Environment Variables.
VITE_API_URL=http://localhost:4000

# Sama persis dengan GOOGLE_CLIENT_ID di server/.env — Client ID Google memang dirancang
# untuk terlihat publik di sisi browser (beda dari Client Secret yang harus dirahasiakan).
VITE_GOOGLE_CLIENT_ID=

# Sama persis dengan MIDTRANS_CLIENT_KEY di server/.env — Client Key Midtrans juga memang
# untuk dipakai di browser (beda dari Server Key yang harus dirahasiakan di backend saja).
VITE_MIDTRANS_CLIENT_KEY=
# Samakan dengan MIDTRANS_IS_PRODUCTION di server/.env
VITE_MIDTRANS_IS_PRODUCTION=false

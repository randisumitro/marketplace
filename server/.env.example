# Salin file ini jadi .env lalu isi nilainya. JANGAN commit file .env ke GitHub!

PORT=4000
NODE_ENV=development

# Isi dengan connection string dari MongoDB Atlas (lihat panduan di README)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/oneshop?retryWrites=true&w=majority

# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti_dengan_string_random_64_karakter
JWT_EXPIRES_IN=7d

# URL frontend (Vercel) yang diizinkan akses API ini via CORS
CLIENT_ORIGIN=http://localhost:5173

# Cloudinary — untuk upload foto produk. Daftar gratis di https://cloudinary.com
# Ambil 3 nilai ini dari Dashboard setelah login (langsung terlihat di halaman utama)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth — untuk tombol "Lanjutkan dengan Google". Setup di https://console.cloud.google.com
GOOGLE_CLIENT_ID=

# Midtrans — payment gateway sungguhan. Daftar di https://dashboard.sandbox.midtrans.com/register
# (mode Sandbox gratis dan tanpa verifikasi bisnis, cukup untuk testing/portofolio — jangan pernah
# masukkan Server Key produksi di sini kalau belum siap menerima pembayaran sungguhan)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Twilio Verify — untuk kirim & cek kode OTP nomor HP sungguhan. Daftar di https://www.twilio.com/try-twilio
# (akun trial punya kredit gratis, tapi cuma bisa kirim SMS ke nomor yang sudah kamu verifikasi
# manual di Twilio Console — cukup untuk testing/portofolio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Resend — untuk email reset password & notifikasi. Daftar gratis di https://resend.com
# (100 email/hari, 3000/bulan, tanpa perlu verifikasi domain untuk mulai)
RESEND_API_KEY=
RESEND_FROM_EMAIL=OneShop <onboarding@resend.dev>
